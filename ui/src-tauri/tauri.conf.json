{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnhancedExtract",
  "version": "0.1.3",
  "identifier": "com.enhancedextract.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EnhancedExtract",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#171719",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": { "../../build/dist/ee-engine/": "engine/", "../../LICENSE": "LICENSE.txt" },
    "publisher": "EnhancedExtract",
    "homepage": "https://github.com/LosSoftwareHermanos/EnhancedExtract",
    "copyright": "© 2026 Sibgha Alfirdausi Rambe",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/art/sidebar.bmp",
        "headerImage": "windows/art/header.bmp",
        "customLanguageFiles": { "English": "windows/English.nsh" }
      }
    }
  }
}
